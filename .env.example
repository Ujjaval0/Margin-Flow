# MarginFlow PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/marginflow"
# Supabase Auth (use the project's URL and publishable/anon key; never use the service-role key here)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Keep 0 on Vercel: supported jobs use after() and authenticated cron recovery.
# Enable 1 only on a persistent Node.js worker host.
MARGINFLOW_JOB_WORKER="0"

# Production on Vercel: use the Supabase shared TRANSACTION pooler (port 6543).
# Username: marginflow_runtime.<project-ref>; password: the runtime role password.
# Copy the real pooler host from Supabase Connect. Require TLS in the URL.
# DATABASE_URL="postgresql://marginflow_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full"
# Set both URLs below to the exact canonical HTTPS origin, with no trailing slash.
# NEXT_PUBLIC_SITE_URL="https://your-final-domain.example"
# APP_ORIGIN="https://your-final-domain.example"
# Stable server-only key, shared across deployments. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""
# Server-only Storage secret (Supabase secret key, or legacy service-role key).
SUPABASE_SECRET_KEY=""
# Separate 32-byte random hex secret for authenticated Vercel queue recovery.
CRON_SECRET=""
# Optional internal caller credential; leave unset unless explicitly needed.
# INTERNAL_SERVICE_KEY=""

# Google Gemini AI Key
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
