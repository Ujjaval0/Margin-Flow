              restoreArchivedRecord: (id: string) => Promise<void>;
            
              // Actions
              addOrder: (order: Order) => Promise<Order>;
              syncExternalOrders: (incomingOrders: Order[]) => Promise<{ added: number; updated: number }>;
              updateOrder: (order: Order) => Promise<Order>;
