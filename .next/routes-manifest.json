{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/jobs/[id]",
      "regex": "^/api/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/audit",
      "regex": "^/audit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/audit(?:/)?$"
    },
    {
      "page": "/claims",
      "regex": "^/claims(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/claims(?:/)?$"
    },
    {
      "page": "/documents",
      "regex": "^/documents(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/documents(?:/)?$"
    },
    {
      "page": "/expenses",
      "regex": "^/expenses(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/expenses(?:/)?$"
    },
    {
      "page": "/ledger",
      "regex": "^/ledger(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ledger(?:/)?$"
    },
    {
      "page": "/orders",
      "regex": "^/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/orders(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products(?:/)?$"
    },
    {
      "page": "/purchases",
      "regex": "^/purchases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/purchases(?:/)?$"
    },
    {
      "page": "/reports",
      "regex": "^/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reports(?:/)?$"
    },
    {
      "page": "/returns",
      "regex": "^/returns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/returns(?:/)?$"
    },
    {
      "page": "/settlements",
      "regex": "^/settlements(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settlements(?:/)?$"
    },
    {
      "page": "/suppliers",
      "regex": "^/suppliers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/suppliers(?:/)?$"
    },
    {
      "page": "/webhooks",
      "regex": "^/webhooks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/webhooks(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}